+    set(QStringLiteral("command"),
+        QStringLiteral("printf '%s|%s\\n' {} {folder} >> '") + said + QStringLiteral("'"));
+    const auto saidLines = [&said] {
+        QFile lines{said};
+        const auto opened = lines.open(QIODevice::ReadOnly);
