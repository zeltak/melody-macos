@@ -1069,6 +1072,56 @@ void LocalLibraryTest::parallelScanIndexesManyFiles() {
     QCOMPARE(library->query(tracks("Retitled"))->entries.size(), 1U);
 }
 
+// A rescan beside another connection writing -- the engine saving where
+// playback is, every few seconds -- is not refused: a statement left on its
+// row kept a read transaction open, and the next write after the other's
+// failed at once with "database is locked", no waiting.
+void LocalLibraryTest::aRescanIsNotRefusedByAnotherWriter() {
+    QTemporaryDir temporary;
+    const std::filesystem::path base{temporary.path().toStdString()};
+    const auto root = base / "music";
+    // More than one batch of unchanged files, so a batch begins after
+    // another has been written.
+    for (int index = 0; index < 1100; ++index) {
+        const auto name = QStringLiteral("%1.flac").arg(index, 4, 10, QLatin1Char('0'));
+        QVERIFY(!fixture(root, name.toStdString(), name.toStdString()).empty());
+    }
+    const auto state = base / "state.sqlite";
+    auto library = persistence::LocalLibrary::open(state);
+    QVERIFY(library && library->add_root(root.native()));
+    persistence::LibraryScanProgress first;
+    QVERIFY(library->scan({}, first).has_value());
+    QCOMPARE(first.indexed.load(), 1100U);
+
+    sqlite3* other = nullptr;
+    QCOMPARE(sqlite3_open(state.c_str(), &other), SQLITE_OK);
+    QCOMPARE(sqlite3_exec(other, "CREATE TABLE beside(n INTEGER); INSERT INTO beside VALUES(0)",
+                          nullptr, nullptr, nullptr),
+             SQLITE_OK);
+    std::atomic<bool> writing{true};
+    // Tried again at once rather than after a busy wait, so it writes
+    // whenever the scan is between transactions.
+    std::jthread writer{[other, &writing] {
+        while (writing) {
+            sqlite3_exec(other, "UPDATE beside SET n=n+1", nullptr, nullptr, nullptr);
+            std::this_thread::yield();
+        }
+    }};
+    // Stopped however the test ends, a failed check included.
+    const auto stop = qScopeGuard([&] {
+        writing = false;
+        writer.join();
+        sqlite3_close(other);
+    });
+    for (int pass = 0; pass < 5; ++pass) {
+        persistence::LibraryScanProgress again;
+        const auto rescanned = library->scan({}, again);
+        QVERIFY2(rescanned.has_value(), rescanned ? "" : rescanned.error().message.c_str());
+        QVERIFY(!rescanned->incomplete);
+        QCOMPARE(again.failed.load(), 0U);
+    }
+}
+
