+bool UpnpAudition::kef_paused_here() {
+    auto transport = call("GetTransportInfo");
+    auto position = call("GetPositionInfo");
+    return transport && position &&
+           value(*transport, "CurrentTransportState") == "PAUSED_PLAYBACK" &&
